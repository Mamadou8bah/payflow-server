# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration (use a secure random value in production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_recommended
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Server Configuration
SERVER_PORT=5000

# Notification Providers
PAYFLOW_SMS_PROVIDER=noop
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

PAYFLOW_EMAIL_PROVIDER=noop
PAYFLOW_EMAIL_API_KEY=your_email_api_key
PAYFLOW_EMAIL_FROM=no-reply@payflow.local

# Modem Pay Configuration
MODEMPAY_API_KEY=your_modem_pay_api_key
MODEMPAY_PUBLIC_KEY=your_modem_pay_public_key
MODEMPAY_API_URL=https://api.modempay.com
MODEMPAY_WEBHOOK_SECRET=your_webhook_signing_secret
MODEMPAY_WEBHOOK_SIGNATURE_HEADER=X-ModemPay-Signature

# Risk Management
PAYFLOW_RISK_CRITICAL_THRESHOLD=9.0
PAYFLOW_RISK_HIGH_THRESHOLD=7.0
PAYFLOW_RISK_MEDIUM_THRESHOLD=5.0
PAYFLOW_RISK_BLOCK_CRITICAL=true
PAYFLOW_RISK_BLOCK_HIGH=false
PAYFLOW_RISK_DAILY_THRESHOLD=50000
PAYFLOW_RISK_DAILY_TRANSACTION_COUNT=20
PAYFLOW_RISK_RAPID_TRANSFER_WINDOW_SECONDS=300
PAYFLOW_RISK_RAPID_TRANSFER_COUNT=5
PAYFLOW_RISK_NEW_WALLET_AGE_DAYS=7
PAYFLOW_RISK_NEW_WALLET_HIGH_VALUE_THRESHOLD=10000

# Spring Profiles (dev, prod)
SPRING_PROFILES_ACTIVE=dev
